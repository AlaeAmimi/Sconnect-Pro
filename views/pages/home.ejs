<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>SportConnect Pro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div class="logo">SportConnect <span>Pro</span></div>
        <nav>
            <a href="/">Accueil</a>
            <a href="/facilities">Infrastructures</a>
            <a href="/associations">Clubs</a>
            <a href="/activities">Activités</a>
        </nav>
    </header>

    <main>
        <section class="hero">
            <h1>Gérez le sport municipal, simplement.</h1>
            <p>Infrastructures, clubs, activités et inscriptions — tout au même endroit.</p>
        </section>

        <section class="cards">
            <div class="card">
                <h2>Infrastructures</h2>
                <p>Gymnases, piscines, dojos et complexes sportifs de la ville.</p>
                <a href="/facilities" class="btn">Voir les infrastructures</a>
            </div>
            <div class="card">
                <h2>Clubs partenaires</h2>
                <p>Les associations sportives affiliées à la municipalité.</p>
                <a href="/associations" class="btn">Voir les clubs</a>
            </div>
            <div class="card">
                <h2>Activités</h2>
                <p>Cours et créneaux disponibles pour tous les âges.</p>
                <a href="/activities" class="btn">Voir les activités</a>
            </div>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 SportConnect Pro — Ville de Casablanca</p>
    </footer>
</body>
</html>