<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Activités — SportConnect Pro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div class="logo">SportConnect <span>Pro</span></div>
        <nav>
            <a href="/">Accueil</a>
            <a href="/facilities">Infrastructures</a>
            <a href="/associations">Clubs</a>
            <a href="/activities">Activités</a>
        </nav>
    </header>

    <main class="page">
        <h1>Activités</h1>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Sport</th>
                    <th>Salle</th>
                    <th>Club</th>
                    <th>Jour</th>
                    <th>Horaire</th>
                    <th>Sous-zone</th>
                    <th>Catégorie</th>
                    <th>Tarif</th>
                    <th>Capacité</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% activities.forEach(function(activity) { %>
                <% const facility = facilities.find(f => f.id === activity.facility_id); %>
                <% const association = associations.find(a => a.id === activity.association_id); %>
                <tr>
                    <td><%= activity.name %></td>
                    <td><%= activity.sport_type %></td>
                    <td><%= facility ? facility.name : '—' %></td>
                    <td><%= association ? association.name : '—' %></td>
                    <td><%= ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'][activity.day_of_week] %></td>
                    <td><%= activity.start_time %> - <%= activity.end_time %></td>
                    <td><%= activity.subzone || '—' %></td>
                    <td><%= activity.age_category %></td>
                    <td><%= activity.base_price %> DH</td>
                    <td><%= activity.max_capacity %></td>
                    <td class="actions">
                        <form action="/activities/<%= activity.id %>/delete" method="POST" class="inline">
                            <button type="submit" class="btn small danger" onclick="return confirm('Supprimer cette activité ?')">Supprimer</button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <h2>Ajouter une activité</h2>
        <form action="/activities" method="POST" class="add-form">
            <select name="facility_id" required>
                <option value="">-- Salle --</option>
                <% facilities.forEach(function(f) { %>
                    <option value="<%= f.id %>"><%= f.name %></option>
                <% }); %>
            </select>

            <select name="association_id" required>
                <option value="">-- Club --</option>
                <% associations.forEach(function(a) { %>
                    <option value="<%= a.id %>"><%= a.name %></option>
                <% }); %>
            </select>

            <input type="text" name="name" placeholder="Nom de l'activité" required>
            <input type="text" name="sport_type" placeholder="Sport" required>

            <select name="is_high_risk">
                <option value="false">Sport standard</option>
                <option value="true">Sport à risque</option>
            </select>

            <select name="age_category" required>
                <option value="eveil">Éveil</option>
                <option value="poussin">Poussin</option>
                <option value="benjamin">Benjamin</option>
                <option value="minime">Minime</option>
                <option value="cadet">Cadet</option>
                <option value="junior">Junior</option>
                <option value="senior">Senior</option>
                <option value="veteran">Vétéran</option>
                <option value="tous_publics">Tous publics</option>
            </select>

            <input type="number" name="base_price" placeholder="Tarif de base" step="0.01" min="0" required>
            <input type="number" name="max_capacity" placeholder="Capacité max" min="1" required>
            <input type="text" name="subzone" placeholder="Sous-zone (optionnel)">

            <select name="day_of_week" required>
                <option value="0">Dimanche</option>
                <option value="1">Lundi</option>
                <option value="2">Mardi</option>
                <option value="3">Mercredi</option>
                <option value="4">Jeudi</option>
                <option value="5">Vendredi</option>
                <option value="6">Samedi</option>
            </select>

            <input type="time" name="start_time" required>
            <input type="time" name="end_time" required>

            <button type="submit" class="btn">Ajouter</button>
        </form>
    </main>
</body>
</html>